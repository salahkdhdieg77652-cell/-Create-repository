# ============================================================
# البحث في الإنترنت
# ============================================================

def search_command(command):

    triggers = [
        "ابحث عن",
        "قلب على",
        "قلبلي على",
        "فتش على",
        "ابحثلي على",
        "search"
    ]

    for trigger in triggers:

        if trigger in command:

            query = command.split(
                trigger,
                1
            )[1].strip()

            if not query:
                speak("قولّي واش نبحثلك عليه.")
                return True

            encoded = urllib.parse.quote_plus(query)

            url = (
                "https://www.google.com/search?q="
                + encoded
            )

            speak(f"نبحثلك على {query}.")
            webbrowser.open(url)

            return True

    return False


# ============================================================
# يوتيوب
# ============================================================

def youtube_search(command):

    triggers = [
        "شغل",
        "شغلي",
        "شغللي",
        "سمعني",
        "حطلي"
    ]

    music_words = [
        "اغنية",
        "أغنية",
        "موسيقى",
        "فيديو",
        "نشيد",
        "music"
    ]

    if any(t in command for t in triggers) and \
       any(w in command for w in music_words):

        query = command

        for word in triggers + music_words:
            query = query.replace(word, "")

        query = query.strip()

        if not query:
            speak("قولّي اسم الأغنية.")
            return True

        url = (
            "https://www.youtube.com/results?search_query="
            + urllib.parse.quote_plus(query)
        )

        speak(f"نقلبلك على {query} في يوتيوب.")
        webbrowser.open(url)

        return True

    return False


