            "الاثنين", "الثلاثاء", "الأربعاء",
            "الخميس", "الجمعة", "السبت", "الأحد"
        ]
        return f"اليوم {days[now.weekday()]}، {now.strftime('%d/%m/%Y')}."

    # --------------------------------------------------------
    # فتح المواقع
    # --------------------------------------------------------
