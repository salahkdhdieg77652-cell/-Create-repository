# ============================================================

def speak(text):
    print("ABB:", text)

    try:
        import subprocess
        subprocess.run(
            ["termux-tts-speak", text],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL
        )
    except Exception:
        pass


