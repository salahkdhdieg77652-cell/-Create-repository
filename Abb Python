        "انستغرام": "https://www.instagram.com",
        "instagram": "https://www.instagram.com",
        "واتساب": "https://web.whatsapp.com",
        "whatsapp": "https://web.whatsapp.com"
    }

    for name, url in sites.items():
        if command == f"افتح {name}" or command == name:
            webbrowser.open(url)
            return f"حاضر، فتحتلك {name}."

    # --------------------------------------------------------
    # البحث في Google
    # --------------------------------------------------------
    search_words = [
        "قلبلي على ",
        "ابحثلي على ",
        "ابحث عن ",
        "قوقل على ",
        "google "
    ]

    for prefix in search_words:
        if command.startswith(prefix):
            query = command[len(prefix):].strip()

            if query:
                url = (
                    "https://www.google.com/search?q="
                    + urllib.parse.quote(query)
                )
                webbrowser.open(url)
                return f"حاضر، قلبتلك على {query}."

    # --------------------------------------------------------
    # البحث في YouTube
    # --------------------------------------------------------
    youtube_words = [
        "قلبلي في يوتيوب على ",
        "ابحث في يوتيوب على ",
        "شغل في يوتيوب "
    ]

    for prefix in youtube_words:
        if command.startswith(prefix):
            query = command[len(prefix):].strip()

            if query:
                url = (
                    "https://www.youtube.com/results?search_query="
                    + urllib.parse.quote(query)
                )
                webbrowser.open(url)
                return f"حاضر، قلبتلك في يوتيوب على {query}."

    # --------------------------------------------------------
    # نكتة
    # --------------------------------------------------------
    if any(x in command for x in ["نكتة", "نكتلي", "ضحكني"]):
        jokes = [
            "واحد راح للطبيب قالو راسي يوجعني، قالو الطبيب: ما تخافش، راهو ماشي غير نتا.",
            "واحد بخيل مات، كتبوا على قبره: ممنوع الوقوف، راهو يخلص الكراء.",
            "واحد سأل صاحبو: علاش الكمبيوتر بردان؟ قالو: خاطر فاتح Windows."
        ]
        return random.choice(jokes)

    # --------------------------------------------------------
    # حكمة
    # --------------------------------------------------------
    if any(x in command for x in ["حكمة", "قول حكمة", "نصيحة"]):
        quotes = [
            "النجاح ما يجيش مرة وحدة، يجي مع الاستمرار.",
            "ما تخافش من البداية الصغيرة، المهم تبدا.",
            "اللي يتعلم كل يوم، يتقدم كل يوم.",
            "الصبر مع العمل يجيب النتيجة."
        ]
        return random.choice(quotes)

    # --------------------------------------------------------
    # رقم عشوائي
    # --------------------------------------------------------
    if "رقم عشوائي" in command or "رقم random" in command:
        return f"الرقم العشوائي هو {random.randint(1, 100)}."

    # --------------------------------------------------------
    # من أنا
    # --------------------------------------------------------
    if any(x in command for x in ["شكون نتا", "من أنت", "واش راك"]):
        return "أنا ABB، المساعد تاعك. نقدر نفهم أوامر بالعربية والدارجة الجزائرية."

    # --------------------------------------------------------
    # تحية
    # --------------------------------------------------------
    if any(x in command for x in ["سلام", "السلام عليكم", "صباح الخير", "مساء الخير"]):
        responses = [
            "وعليكم السلام، مرحبا بيك!",
            "أهلا خويا، ABB راهو حاضر!",
            "مرحبا! واش نعاونك اليوم؟"
        ]
        return random.choice(responses)

    # --------------------------------------------------------
    # حساب آمن للعمليات البسيطة
    # --------------------------------------------------------
    if command.startswith("احسب "):
        expression = command.replace("احسب ", "", 1).strip()

        try:
            allowed = {
                ast.Add: operator.add,
                ast.Sub: operator.sub,
                ast.Mult: operator.mul,
                ast.Div: operator.truediv,
                ast.USub: operator.neg
            }

            def calculate(node):
                if isinstance(node, ast.Constant):
                    if isinstance(node.value, (int, float)):
                        return node.value
                    raise ValueError()

                if isinstance(node, ast.BinOp):
                    op = allowed.get(type(node.op))
                    if not op:
                        raise ValueError()
                    return op(calculate(node.left), calculate(node.right))

                if isinstance(node, ast.UnaryOp):
                    op = allowed.get(type(node.op))
                    if not op:
                        raise ValueError()
                    return op(calculate(node.operand))

                raise ValueError()

            tree = ast.parse(expression, mode="eval")
            result = calculate(tree.body)

            return f"النتيجة هي {result}"

        except Exception:
            return "ما قدرتش نحسبها. جرب مثلا: احسب 25 * 8"

    # --------------------------------------------------------
    # أمر غير معروف
    # --------------------------------------------------------
    return None


