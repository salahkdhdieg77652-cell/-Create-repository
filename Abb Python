# ------------------------------------------------------------
# معالجة الأوامر
# ------------------------------------------------------------

def process_command(command):

    if not command:
        return True

    command = command.lower().strip()

    # -------------------------
    # السكوت
    # -------------------------

    for word in STOP_WORDS:
        if word in command:
            print("🔇 تم تفعيل وضع السكوت.")
            return "SILENT"

    # -------------------------
    # الخروج
    # -------------------------

    for word in EXIT_WORDS:
        if word in command:
            speak("حاضر، نشوفك من بعد. سلام ❤️")
            return False

    # -------------------------
    # السلام
    # -------------------------

    if (
        "سلام" in command
        or "السلام عليكم" in command
    ):
        speak(random.choice(GREETINGS))
        return True

    # -------------------------
    # الاسم
    # -------------------------

    if (
        "اسمك" in command
        or "شكون نتي" in command
        or "من انتي" in command
    ):
        speak(
            "أنا عب، المساعدة الصوتية تاعك."
        )
        return True

    # -------------------------
    # الوقت
    # -------------------------

    if "الساعة" in command:
        speak(get_time())
        return True

    # -------------------------
    # التاريخ
    # -------------------------

    if (
        "التاريخ" in command
        or "اليوم شحال" in command
    ):
        speak(get_date())
        return True

    # -------------------------
    # غوغل
    # -------------------------

    if (
        "افتح غوغل" in command
        or "افتح جوجل" in command
    ):
        open_google()
        return True

    # -------------------------
    # يوتيوب
    # -------------------------

    if "افتح يوتيوب" in command:
        open_youtube()
        return True

    # -------------------------
    # البحث
    # -------------------------

    if command.startswith("ابحث عن"):
        query = command.replace(
            "ابحث عن",
            "",
            1
        ).strip()

        search_google(query)
        return True

    if command.startswith("قلب على"):
        query = command.replace(
            "قلب على",
            "",
            1
        ).strip()

        search_google(query)
        return True

    # -------------------------
    # المزاح
    # -------------------------

    if (
        "نكتة" in command
        or "نكت" in command
        or "ضحكني" in command
    ):
        speak(random.choice(FUNNY))
        return True

    # -------------------------
    # كلام لطيف
    # -------------------------

    if (
        "نحبك" in command
        or "نحماق عليك" in command
    ):
        speak(
            "هههه شكرا خويا ❤️ "
            "أنا هنا غير باش نعاونك ونونسّك."
        )
        return True

