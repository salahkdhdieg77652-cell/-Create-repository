APP_NAME = "ABB"


# ============================================================
# الصوت
# ============================================================

def speak(text):
    """طباعة الرد ومحاولة نطقه صوتياً."""
    print(f"\n{APP_NAME}: {text}")

    try:
        if platform.system().lower() == "android":
            subprocess.run(
                ["termux-tts-speak", text],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                timeout=10
            )
    except Exception:
        pass


# ============================================================
# الوقت والتاريخ
# ============================================================

def current_time():
    now = datetime.datetime.now()
    return now.strftime("%H:%M")


def current_date():
    now = datetime.datetime.now()
    return now.strftime("%Y-%m-%d")


# ============================================================
# فتح المواقع
# ============================================================

def open_google():
    webbrowser.open("https://www.google.com")


def open_youtube():
    webbrowser.open("https://www.youtube.com")


def search_google(query):
    if not query:
        speak("قولّي واش نبحثلك عليه.")
        return

    url = "https://www.google.com/search?q=" + urllib.parse.quote(query)
    webbrowser.open(url)
    speak(f"راني نبحثلك على {query}")


def search_youtube(query):
    if not query:
        speak("قولّي واش نبحث في يوتيوب.")
        return

    url = "https://www.youtube.com/results?search_query=" + urllib.parse.quote(query)
    webbrowser.open(url)
    speak(f"راني نقلب في يوتيوب على {query}")


# ============================================================
# تشغيل التطبيقات - Android / Termux
# ============================================================

def open_app(package_name):
    try:
        subprocess.run(
            ["monkey", "-p", package_name, "1"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=10
        )
        return True
    except Exception:
        return False


def try_open_apps(command):
    command = command.lower()

    if "يوتيوب" in command:
        open_youtube()
        speak("فتحت يوتيوب.")
        return True

    if "جوجل" in command or "غوغل" in command:
        open_google()
        speak("فتحت جوجل.")
        return True

    if "واتساب" in command:
        if open_app("com.whatsapp"):
            speak("فتحت واتساب.")
        else:
            speak("ماقدرتش نفتح واتساب من هنا.")
        return True

    if "تيليغرام" in command or "تلغرام" in command:
        if open_app("org.telegram.messenger"):
            speak("فتحت تيليغرام.")
        else:
            speak("ماقدرتش نفتح تيليغرام.")
        return True

    if "إنستغرام" in command or "انستغرام" in command:
        if open_app("com.instagram.android"):
            speak("فتحت إنستغرام.")
        else:
            speak("ماقدرتش نفتح إنستغرام.")
        return True

    return False


