def random_command(command):

    if "رقم عشوائي" in command:

        match = re.search(
            r"(\d+)\s*(?:الى|إلى|-)\s*(\d+)",
            command
        )

        if match:

            a = int(match.group(1))
            b = int(match.group(2))

            result = random.randint(
                min(a, b),
                max(a, b)
            )

            speak(
                f"خرجلك الرقم {result}."
            )

        else:

            speak(
                f"الرقم العشوائي هو {random.randint(1, 100)}."
            )

        return True

    return False


# ============================================================
# الانتظار
# ============================================================

def timer_command(command):

    match = re.search(
        r"(\d+)\s*(ثانية|ثواني|دقيقة|دقائق)",
        command
    )

    if not match:
        return False

    amount = int(match.group(1))
    unit = match.group(2)

    seconds = amount

    if "دقيقة" in unit:
        seconds *= 60

    speak(
        f"بدأت المؤقت لمدة {amount} {unit}."
    )

    time.sleep(seconds)

    speak("⏰ سالى الوقت!")

    return True


