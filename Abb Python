# ============================================================
# الحسابات البسيطة
# ============================================================

def calculator_command(command):

    if not any(x in command for x in [
        "احسب",
        "حسبلي",
        "احسبلي"
    ]):
        return False

    expression = command

    for word in [
        "احسبلي",
        "احسب",
        "حسبلي"
    ]:
        expression = expression.replace(
            word,
            ""
        )

    expression = expression.strip()

    expression = expression.replace(
        "زائد",
        "+"
    )

    expression = expression.replace(
        "ناقص",
        "-"
    )

    expression = expression.replace(
        "ضرب",
        "*"
    )

    expression = expression.replace(
        "في",
        "*"
    )

    expression = expression.replace(
        "قسمة",
        "/"
    )

    # السماح فقط بالأرقام والعمليات
    if not re.fullmatch(
        r"[0-9+\-*/(). ]+",
        expression
    ):
        speak(
            "نقدر نحسب العمليات الرياضية البسيطة فقط."
        )
        return True

    try:

        result = eval(
            expression,
            {"__builtins__": {}},
            {}
        )

        speak(f"النتيجة هي {result}.")

    except Exception:

        speak("ما فهمتش العملية.")

    return True


