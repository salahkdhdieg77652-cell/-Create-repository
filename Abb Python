
import pyttsx3

# تشغيل الصوت
engine = pyttsx3.init()
engine.setProperty("rate", 165)

name = "برهوم"

def speak(text):
    print("Abb:", text)
    engine.say(text)
    engine.runAndWait()

def abb():
    speak(f"سلام {name} ❤️ أنا Abb، صاحبتك الافتراضية.")
    speak("نهدر معاك بالدارجة الجزائرية ونسمعلك ونعاونك.")

    while True:
        try:
            user = input(f"{name}: ")

            if user.lower() in ["خروج", "اخرجي", "bye", "exit"]:
                speak("باي برهوم ❤️ ربي يحفظك.")
                break

            if "تسكوت" in user or "اسكتي" in user:
                continue

            if "سلام" in user:
                speak("وعليكم السلام يا برهوم 😄 واش حوالك؟")

            elif "شكون نتي" in user or "من انتي" in user:
                speak("أنا Abb، المساعدة الافتراضية تاعك ❤️")

            elif "نحبك" in user:
                speak("هههه وأنا نحب نعاونك ونكون معاك بالكلمة الزينة ❤️")

            elif "كيفاش راكي" in user:
                speak("راني مليحة مادام راني نهدر معاك 😄")

            else:
                speak("سمعتك يا برهوم ❤️ احكيلي أكثر، راني نسمعلك.")

        except KeyboardInterrupt:
            break

abb()
