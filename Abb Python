def get_time():
    now = datetime.datetime.now()

    hour = now.strftime("%H")
    minute = now.strftime("%M")

    return f"الساعة راهي {hour}:{minute}"


def get_date():
    now = datetime.datetime.now()

    days = [
        "الاثنين",
        "الثلاثاء",
        "الأربعاء",
        "الخميس",
        "الجمعة",
        "السبت",
        "الأحد"
    ]

    months = [
        "جانفي",
        "فيفري",
        "مارس",
        "أفريل",
        "ماي",
        "جوان",
        "جويلية",
        "أوت",
        "سبتمبر",
        "أكتوبر",
        "نوفمبر",
        "ديسمبر"
    ]

    day_name = days[now.weekday()]
    month_name = months[now.month - 1]

    return (
        f"اليوم {day_name}، "
        f"{now.day} {month_name} {now.year}"
    )


