def system_command(command):

    if "معلومات الجهاز" in command or "معلومات الهاتف" in command:
        speak(
            f"النظام هو {platform.system()} "
            f"{platform.release()}، "
            f"والمعالج {platform.machine()}."
        )
        return True

    if "النظام" in command:
        speak(f"النظام عندك هو {platform.system()}.")
        return True

    return False


