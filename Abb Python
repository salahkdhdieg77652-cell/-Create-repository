# ------------------------------------------------------------
# الإعدادات
# ------------------------------------------------------------

ASSISTANT_NAME = "عب"
WAKE_WORDS = ["عب", "آب", "abb", "اب"]

STOP_WORDS = [
    "تسكوة",
    "اسكتي",
    "اسكت",
    "حبسي",
    "سكات",
    "اسكتي عب"
]

EXIT_WORDS = [
    "خلاص",
    "روحي",
    "باي",
    "مع السلامة",
    "اغلقي",
    "اخرجي"
]


# ------------------------------------------------------------
# تشغيل الصوت
# ------------------------------------------------------------

engine = None

if pyttsx3:
    try:
        engine = pyttsx3.init()

        # سرعة الكلام
        engine.setProperty("rate", 165)

        # مستوى الصوت
        engine.setProperty("volume", 1.0)

        # اختيار صوت مناسب إن وجد
        voices = engine.getProperty("voices")

        if voices:
            for voice in voices:
                name = str(getattr(voice, "name", "")).lower()
                lang = str(getattr(voice, "languages", "")).lower()

                if "arab" in name or "arab" in lang:
                    engine.setProperty("voice", voice.id)
                    break

    except Exception:
        engine = None


def speak(text):
    """
    تحويل النص إلى كلام.
    """

    print(f"\n{ASSISTANT_NAME}: {text}")

    if engine is None:
        return

    try:
        engine.say(text)
        engine.runAndWait()
    except Exception as error:
        print("Voice error:", error)


# ------------------------------------------------------------
# الاستماع
# ------------------------------------------------------------

recognizer = sr.Recognizer() if sr else None


def listen(timeout=5, phrase_time_limit=8):
    """
    يسمع كلام المستخدم ويحوله إلى نص.
    """

    if recognizer is None:
        print("مكتبة speech_recognition غير مثبتة.")
        return ""

    try:
        with sr.Microphone() as source:

            print("\n🎤 نسمع فيك...")

            recognizer.adjust_for_ambient_noise(
                source,
                duration=0.5
            )

            audio = recognizer.listen(
                source,
                timeout=timeout,
                phrase_time_limit=phrase_time_limit
            )

        print("🔄 نحاول نفهم...")

        # Google Speech Recognition
        text = recognizer.recognize_google(
            audio,
            language="ar-DZ"
        )

        text = text.lower().strip()

        print("أنت:", text)

        return text

    except sr.WaitTimeoutError:
        return ""

    except sr.UnknownValueError:
        print("ما فهمتش واش قلت.")
        return ""

    except sr.RequestError:
        print("مشكل في خدمة التعرف على الصوت.")
        return ""

    except Exception as error:
        print("Microphone error:", error)
        return ""


