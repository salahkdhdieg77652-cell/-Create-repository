def speak(text):
    print(f"\n{NAME}: {text}")

    try:
        subprocess.run(
            ["termux-tts-speak", "-l", "ar", "-r", "0.9", text],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL
        )
    except Exception:
        pass


# ============================================================
# فتح المواقع
# ============================================================

def open_url(url):
    try:
        webbrowser.open(url)
        return True
    except Exception:
        return False


# ============================================================
# البحث في Google
# ============================================================

def google_search(text):
    query = urllib.parse.quote(text)
    open_url("https://www.google.com/search?q=" + query)


# ============================================================
# يوتيوب
# ============================================================

def youtube_search(text):
    query = urllib.parse.quote(text)
    open_url("https://www.youtube.com/results?search_query=" + query)


