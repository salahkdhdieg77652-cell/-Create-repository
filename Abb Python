# ============================================================
# أدوات عامة
# ============================================================

def now():
    return datetime.datetime.now()


def save_json(filename, data):
    try:
        with open(filename, "w", encoding="utf-8") as f:
            json.dump(data, f, ensure_ascii=False, indent=2)
    except Exception:
        pass


def load_json(filename, default):
    try:
        with open(filename, "r", encoding="utf-8") as f:
            return json.load(f)
    except Exception:
        return default


memory = load_json(MEMORY_FILE, {})
history = load_json(HISTORY_FILE, [])


def speak(text):
    """نطق النص إذا كان Termux:API مثبتًا، وإلا يطبعه فقط."""
    print(f"\n{APP_NAME}: {text}")

    try:
        subprocess.run(
            ["termux-tts-speak", "-l", "ar", "-r", "0.95", text],
            timeout=10
        )
    except Exception:
        pass


def listen():
    """
    في Termux يستعمل termux-speech-to-text.
    إذا لم يكن متوفرًا، يسمح بالكتابة من الكيبورد.
    """

    try:
        result = subprocess.run(
            ["termux-speech-to-text"],
            capture_output=True,
            text=True,
            timeout=30
        )

        text = result.stdout.strip()

        if text:
            print("أنت:", text)
            return text.lower().strip()

    except Exception:
        pass

    try:
        return input("\nأنت: ").lower().strip()
    except KeyboardInterrupt:
        return "خروج"


# ============================================================
# الذاكرة
# ============================================================

def remember(command):
    global memory

    match = re.search(
        r"(?:تذكر|احفظ|خلي في بالك)\s+(.+)",
        command
    )

    if match:
        value = match.group(1).strip()

        if value:
            memory[str(len(memory) + 1)] = value
            save_json(MEMORY_FILE, memory)

            speak("حفظتها في الذاكرة.")
            return True

    return False


def show_memory():
    if not memory:
        speak("مازال ما عنديش معلومات محفوظة.")
        return True

    speak("هاذي المعلومات لي حافظهم:")

    for key, value in memory.items():
        print(f"{key}. {value}")

    return True


def clear_memory():
    global memory

    memory = {}
    save_json(MEMORY_FILE, memory)

    speak("مسحت الذاكرة.")
    return True


# ============================================================
# سجل الأوامر
# ============================================================

def add_history(command):
    global history

    history.append({
        "command": command,
        "time": now().strftime("%Y-%m-%d %H:%M:%S")
    })

    history = history[-100:]

    save_json(HISTORY_FILE, history)


def show_history():
    if not history:
        speak("مازال ما كاش سجل.")
        return True

    speak("آخر الأوامر:")

    for item in history[-10:]:
        print(
            f"- {item['time']} | {item['command']}"
        )

    return True


